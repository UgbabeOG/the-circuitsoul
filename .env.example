# CircuitSoul Monorepo Environment Configuration
# Copy this to .env for local development

NODE_ENV=development

# Local PostgreSQL/Redis passwords. Replace with unique random values before use.
POSTGRES_USER="circuitsoul"
POSTGRES_PASSWORD="CHANGE_ME_POSTGRES_PASSWORD"
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"

# Database (PostgreSQL 16). Use POSTGRES_PASSWORD above, URL-encoding special characters.
DATABASE_URL="postgresql://circuitsoul:CHANGE_ME_DB_PASSWORD@localhost:5432/circuitsoul_db?schema=public"

# Redis (BullMQ Queues). URL-encode REDIS_PASSWORD if it contains reserved URL characters.
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379"

# Engine Mock Flags
# Set to 'true' only for local development without live OSS engines.
# Production MUST set this to 'false'. Live engine failures return errors,
# never mock data.
USE_MOCK_ENGINES=false

# Security & Sessions
CIRCUITSOUL_AUTH_SECRET="CHANGE_ME_AUTH_SECRET_MIN_32_CHARS"
GATEWAY_SECRET_KEY="CHANGE_ME_GATEWAY_SECRET"
CREDENTIAL_ENCRYPTION_KEY="CHANGE_ME_CREDENTIAL_ENCRYPTION_KEY_MIN_32_CHARS"
# Set to 'custom' (default) or 'clerk' to select the provider-backed session verifier.
AUTH_PROVIDER="custom"
CLERK_PUBLIC_KEY=""
# Set true only for local development. Production must never enable this.
ALLOW_DEV_SESSION=false
# Comma-separated exact email addresses allowed to access the global Admin app.
# Keep this server-side variable unset/empty to deny all platform-admin access.
CIRCUITSOUL_PLATFORM_ADMIN_EMAILS=""

# AI Services
OPENAI_API_KEY=""

# Open-Source Engine Endpoints (Mapped via Docker Compose)
N8N_API_URL="http://localhost:5678/api/v1"
N8N_API_KEY="CHANGE_ME_N8N_API_KEY"
N8N_WEBHOOK_URL="http://localhost:5678/webhook"

GHOST_API_URL="http://localhost:2368/ghost/api/admin"
GHOST_ADMIN_API_KEY="CHANGE_ME_GHOST_ADMIN_API_KEY"

WAZUH_API_URL="https://localhost:55000"
WAZUH_USER="CHANGE_ME_WAZUH_USER"
WAZUH_PASSWORD="CHANGE_ME_WAZUH_PASSWORD"

PROMETHEUS_API_URL="http://localhost:9090/api/v1"

# Storage (AWS S3 or MinIO)
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="circuitsoul-dev-bucket"
# S3_ENDPOINT="http://localhost:9000" # Uncomment for local MinIO

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
