datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VulnerabilityStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  FALSE_POSITIVE
}

enum CloudProvider {
  AWS
  GCP
  AZURE
}

enum FlowStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AssessmentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIAL
  EXPIRED
}

model Plan {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  description   String?
  interval      BillingInterval  @default(MONTHLY)
  price         Decimal          @db.Decimal(12, 2)
  currency      String           @default("USD")
  features      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  userId             String?
  user               User?              @relation(fields: [userId], references: [id])
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  usageRecords       UsageRecord[]
}

model UsageRecord {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  metric         String
  quantity       Int
  recordedAt     DateTime     @default(now())
  notes          String?
}

model UsageEvent {
  id             String   @id @default(uuid())
  organizationId String
  subscriptionId String?
  userId         String?
  jobId          String?
  eventType      String   @default("AI_GENERATION")
  tokensUsed     Int      @default(0)
  storageBytes   Int      @default(0)
  generationMs   Int      @default(0)
  jobsExecuted   Int      @default(1)
  rawPayload     Json?
  aggregated     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, aggregated, createdAt])
  @@index([subscriptionId, aggregated])
}

enum AiGenerationType {
  BLOG_CONTENT
  BLOG_HERO
  SHIELD_REMEDIATION
  CLOUDOPS_RECOMMENDATION
  FLOW_TRANSLATION
}

enum NotificationType {
  ALERT
  NEWSLETTER
  SYSTEM
  BILLING
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  blogPosts     BlogPost[]
  activityLogs  ActivityLog[]
  subscriptions Subscription[]
  shieldAssessmentsCreated ShieldAssessment[] @relation("CreatedShieldAssessment")
  aiGenerationsByUser AiGeneration[] @relation("AiGenerationByUser")
}

enum AssetType {
  DOMAIN
  IP_ADDRESS
  WEB_APP
  DATABASE
  CLOUD_STORAGE
}

model Organization {
  id                 String                      @id @default(uuid())
  name               String
  slug               String                      @unique
  logoUrl            String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  memberships        Membership[]
  assessments        ShieldAssessment[]
  assets             Asset[]
  ndprAssessments    NDPRAssessment[]
  consultingRequests SecurityConsultingRequest[]
  environments       CloudEnvironment[]
  workflows          FlowWorkflow[]
  aiGenerations      AiGeneration[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  subscriptions      Subscription[]
  blogPosts          BlogPost[]
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model Asset {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           AssetType          @default(DOMAIN)
  target         String             // e.g. "api.startup.ng" or "197.210.64.12"
  isAuthorized   Boolean            @default(true) // explicit SME owner authorization
  verified       Boolean            @default(false)
  lastScannedAt  DateTime?
  assessments    ShieldAssessment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, target])
}

model ShieldAssessment {
  id                  String                @id @default(uuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId             String?
  asset               Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  status              AssessmentStatus      @default(PENDING)
  score               Int                   // Overall score out of 100
  overallRisk         String                // "LOW" | "MEDIUM" | "HIGH"
  isVerifiedTechnical Boolean               @default(false)
  reportPdfUrl        String?
  vulnerabilities     ShieldVulnerability[]
  createdById         String?
  createdBy           User?                 @relation("CreatedShieldAssessment", fields: [createdById], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([organizationId, createdAt])
}

model NDPRAssessment {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  score            Int          // 0-100
  compliant        Boolean      @default(false)
  answersJson      String       // JSON string of 20 statutory questions across the 4 pillars
  reportPdfUrl     String?
  remediationsJson String?
  conductedBy      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, createdAt])
}

model SecurityConsultingRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactName    String
  contactEmail   String
  contactPhone   String?
  scope          String       // "PENETRATION_TESTING" | "NDPR_AUDIT_ASSISTANCE" | "CLOUD_HARDENING" | "INCIDENT_RESPONSE"
  notes          String?
  status         String       @default("PENDING") // PENDING, CONTACTED, ENGAGED, COMPLETED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model ShieldVulnerability {
  id           String             @id @default(uuid())
  assessmentId String
  assessment   ShieldAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title        String
  severity     Severity
  description  String
  remediation  String
  status       VulnerabilityStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum CloudEnvironmentStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model CloudEnvironment {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       CloudProvider
  name           String
  credentialsJson String          // Plaintext credentials - to be migrated to encrypted fields
  credentialsEncrypted String?  // Encrypted API keys/credentials (AES-256-GCM)
  credentialsIv    String?        // Initialization vector for credential decryption
  status         CloudEnvironmentStatus @default(CONNECTED)
  score          Int              // Cloud health score
  costMonthly    Decimal          @db.Decimal(12, 2)
  metrics        CloudMetric[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CloudMetric {
  id             String           @id @default(uuid())
  environmentId  String
  environment    CloudEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  cpuUtilization Float
  memoryUtilization Float
  costDaily      Decimal          @db.Decimal(12, 2)
  timestamp      DateTime         @default(now())
}

model FlowWorkflow {
  id                 String          @id @default(uuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  status             FlowStatus      @default(DRAFT)
  triggerType        String
  definitionJson     String          // Dynamic workflow node configuration
  externalWorkflowId String?         // ID of the mapped workflow in n8n engine
  executions         FlowExecution[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([organizationId, status])
}

model FlowExecution {
  id         String          @id @default(uuid())
  workflowId String
  workflow   FlowWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     ExecutionStatus @default(RUNNING)
  startedAt  DateTime        @default(now())
  completedAt DateTime?
  logsJson   String?         // Run traces & errors

  @@index([workflowId, startedAt])
}

model BlogPost {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  title          String
  slug           String        @unique
  content        String
  summary        String?
  status         BlogStatus    @default(DRAFT)
  seoKeywords    String[]
  heroImageUrl   String?
  trendSource    String?       // Ingested Google Trends / RSS Source URL
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
}

model AiGeneration {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("AiGenerationByUser", fields: [userId], references: [id])
  prompt         String
  response       String
  tokenCount     Int
  type           AiGenerationType
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())
}

enum JobStatus {
  ATTEMPT
  SUCCEEDED
  FAILED
  DLQ
}

model JobLog {
  id        String   @id @default(uuid())
  jobId     String
  queueName String
  jobName   String
  attempt   Int
  status    JobStatus
  error     String?
  payload   Json?
  createdAt DateTime @default(now())
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?          // If null, notify whole org
  title          String
  message        String
  read           Boolean          @default(false)
  type           NotificationType @default(SYSTEM)
  createdAt      DateTime         @default(now())
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  ipAddress      String?
  userAgent      String?
  metadataJson   String?      // Action-specific dynamic parameters
  createdAt      DateTime     @default(now())
}
