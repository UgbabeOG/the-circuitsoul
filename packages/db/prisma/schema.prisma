datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VulnerabilityStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  FALSE_POSITIVE
}

enum CloudProvider {
  AWS
  GCP
  AZURE
}

enum FlowStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AiGenerationType {
  BLOG_CONTENT
  BLOG_HERO
  SHIELD_REMEDIATION
  CLOUDOPS_RECOMMENDATION
  FLOW_TRANSLATION
}

enum NotificationType {
  ALERT
  NEWSLETTER
  SYSTEM
  BILLING
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  blogPosts     BlogPost[]
  activityLogs  ActivityLog[]
}

model Organization {
  id            String             @id @default(uuid())
  name          String
  slug          String             @unique
  logoUrl       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  memberships   Membership[]
  assessments   ShieldAssessment[]
  environments  CloudEnvironment[]
  workflows     FlowWorkflow[]
  aiGenerations AiGeneration[]
  notifications Notification[]
  activityLogs  ActivityLog[]
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model ShieldAssessment {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String               // "PENDING" | "COMPLETED" | "FAILED"
  score          Int                  // Overall score out of 100
  overallRisk    String               // "LOW" | "MEDIUM" | "HIGH"
  vulnerabilities ShieldVulnerability[]
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model ShieldVulnerability {
  id           String             @id @default(uuid())
  assessmentId String
  assessment   ShieldAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title        String
  severity     Severity
  description  String
  remediation  String
  status       VulnerabilityStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CloudEnvironment {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       CloudProvider
  name           String
  credentialsJson String          // Encrypted API keys/credentials
  status         String           // "CONNECTED" | "DISCONNECTED" | "ERROR"
  score          Int              // Cloud health score
  costMonthly    Decimal          @db.Decimal(12, 2)
  metrics        CloudMetric[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CloudMetric {
  id             String           @id @default(uuid())
  environmentId  String
  environment    CloudEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  cpuUtilization Float
  memoryUtilization Float
  costDaily      Decimal          @db.Decimal(12, 2)
  timestamp      DateTime         @default(now())
}

model FlowWorkflow {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         FlowStatus      @default(DRAFT)
  triggerType    String
  definitionJson String          // Dynamic workflow node configuration
  executions     FlowExecution[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model FlowExecution {
  id         String          @id @default(uuid())
  workflowId String
  workflow   FlowWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     ExecutionStatus @default(RUNNING)
  startedAt  DateTime        @default(now())
  completedAt DateTime?
  logsJson   String?         // Run traces & errors
}

model BlogPost {
  id           String      @id @default(uuid())
  authorId     String
  author       User        @relation(fields: [authorId], references: [id])
  title        String
  slug         String      @unique
  content      String
  summary      String?
  status       BlogStatus  @default(DRAFT)
  seoKeywords  String[]
  heroImageUrl String?
  trendSource  String?     // Ingested Google Trends / RSS Source URL
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AiGeneration {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  prompt         String
  response       String
  tokenCount     Int
  type           AiGenerationType
  createdAt      DateTime         @default(now())
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?          // If null, notify whole org
  title          String
  message        String
  read           Boolean          @default(false)
  type           NotificationType @default(SYSTEM)
  createdAt      DateTime         @default(now())
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  ipAddress      String?
  userAgent      String?
  metadataJson   String?      // Action-specific dynamic parameters
  createdAt      DateTime     @default(now())
}
